{
  "name": "sweet-edge-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "cms": "node scripts/cms-local.mjs",
    "test": "node --test tests/*.test.js",
    "migrate": "node scripts/migrate-content.mjs",
    "prebuild": "node scripts/clean.mjs",
    "predev": "node scripts/clean.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "cheerio": "1.2.0",
    "decap-cms": "3.16.3",
    "decap-server": "3.11.3",
    "markdown-it": "15.0.2",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "yaml": "2.9.1"
  }
}
